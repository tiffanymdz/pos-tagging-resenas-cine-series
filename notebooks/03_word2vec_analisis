    "\n",
    "# CELDA 6: SIMILITUDES Y CAMPOS SEMÁNTICOS\n",
    "\n",
    "import pandas as pd\n",
    "import unicodedata\n",
    "\n",
    "def quitar_tildes(texto):\n",
    "    texto = unicodedata.normalize(\"NFD\", texto.lower())\n",
    "    return \"\".join(\n",
    "        letra for letra in texto\n",
    "        if unicodedata.category(letra) != \"Mn\"\n",
    "    )\n",
    "\n",
    "def buscar_palabra(modelo, palabra):\n",
    "    palabra = palabra.lower()\n",
    "\n",
    "    if palabra in modelo.wv:\n",
    "        return palabra\n",
    "\n",
    "    equivalente = quitar_tildes(palabra)\n",
    "\n",
    "    for termino in modelo.wv.index_to_key:\n",
    "        if quitar_tildes(termino) == equivalente:\n",
    "            return termino\n",
    "\n",
    "    return None\n",
    "\n",
    "campos_semanticos = {\n",
    "    \"Cine\": [\"película\", \"actor\", \"director\", \"guion\"],\n",
    "    \"Emociones\": [\"miedo\", \"alegría\", \"tristeza\"],\n",
    "    \"Géneros\": [\"terror\", \"comedia\", \"drama\", \"acción\"],\n",
    "    \"Valoraciones\": [\"excelente\", \"malo\", \"aburrido\"]\n",
    "}\n",
    "\n",
    "resultados_semanticos = []\n",
    "\n",
    "for nombre, modelo in [\n",
    "    (\"CBOW\", modelo_cbow),\n",
    "    (\"Skip-Gram\", modelo_skipgram)\n",
    "]:\n",
    "    for campo, palabras in campos_semanticos.items():\n",
    "        for palabra in palabras:\n",
    "\n",
    "            encontrada = buscar_palabra(modelo, palabra)\n",
    "\n",
    "            if encontrada is None:\n",
    "                resultados_semanticos.append({\n",
    "                    \"modelo\": nombre,\n",
    "                    \"campo\": campo,\n",
    "                    \"palabra\": palabra,\n",
    "                    \"termino_usado\": None,\n",
    "                    \"similar\": \"Fuera del vocabulario\",\n",
    "                    \"similitud\": None\n",
    "                })\n",
    "                continue\n",
    "\n",
    "            similares = modelo.wv.most_similar(\n",
    "                encontrada,\n",
    "                topn=5\n",
    "            )\n",
    "\n",
    "            for termino, puntuacion in similares:\n",
    "                resultados_semanticos.append({\n",
    "                    \"modelo\": nombre,\n",
    "                    \"campo\": campo,\n",
    "                    \"palabra\": palabra,\n",
    "                    \"termino_usado\": encontrada,\n",
    "                    \"similar\": termino,\n",
    "                    \"similitud\": round(float(puntuacion), 4)\n",
    "                })\n",
    "\n",
    "tabla_semantica = pd.DataFrame(resultados_semanticos)\n",
    "\n",
    "print(\"RESULTADOS DE CAMPOS SEMÁNTICOS\")\n",
    "display(tabla_semantica)\n",
    "\n",
    "tabla_semantica.to_csv(\n",
    "    SALIDA / \"campos_semanticos.csv\",\n",
    "    index=False,\n",
    "    encoding=\"utf-8-sig\"\n",
    ")\n",
    "\n",
    "print(\"\\nArchivo guardado: campos_semanticos.csv\")\n"
   ]
