    "\n",
    "import re\n",
    "import pandas as pd\n",
    "\n",
    "# Trabajar con una copia de los datos originales\n",
    "pos_limpio = pos.copy()\n",
    "\n",
    "# Conservar las categorías gramaticales de contenido\n",
    "pos_limpio = pos_limpio[\n",
    "    pos_limpio[\"upos_spacy\"].isin(\n",
    "        [\"NOUN\", \"VERB\", \"ADJ\", \"ADV\"]\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "# Usar TOKEN en lugar de LEMA\n",
    "pos_limpio[\"palabra\"] = (\n",
    "    pos_limpio[\"token\"]\n",
    "    .fillna(\"\")\n",
    "    .astype(str)\n",
    "    .str.lower()\n",
    "    .str.strip()\n",
    ")\n",
    "\n",
    "# Eliminar números, signos y tokens vacíos\n",
    "pos_limpio = pos_limpio[\n",
    "    pos_limpio[\"palabra\"].str.fullmatch(\n",
    "        r\"[a-záéíóúüñ]{2,}\",\n",
    "        na=False\n",
    "    )\n",
    "].copy()\n",
    "\n",
    "# Crear las oraciones para entrenar Word2Vec\n",
    "oraciones = (\n",
    "    pos_limpio\n",
    "    .groupby([\"id\", \"oracion\"], sort=False)[\"palabra\"]\n",
    "    .apply(list)\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "oraciones = [\n",
    "    oracion for oracion in oraciones\n",
    "    if len(oracion) >= 2\n",
    "]\n",
    "\n",
    "# Crear un documento por reseña\n",
    "documentos = (\n",
    "    pos_limpio\n",
    "    .groupby(\"id\", sort=False)[\"palabra\"]\n",
    "    .apply(list)\n",
    "    .reset_index(name=\"tokens\")\n",
    ")\n",
    "\n",
    "# Mantener un orden estable para alinear los vectores\n",
    "documentos = documentos.sort_values(\n",
    "    \"id\"\n",
    ").reset_index(drop=True)\n",
    "\n",
    "# Crear texto para BoW y TF-IDF\n",
    "documentos[\"texto\"] = documentos[\"tokens\"].apply(\n",
    "    lambda palabras: \" \".join(palabras)\n",
    ")\n",
    "\n",
    "print(\"PREPARACIÓN COMPLETADA\")\n",
    "print(\"Reseñas procesadas:\", len(documentos))\n",
    "print(\"Oraciones para Word2Vec:\", len(oraciones))\n",
    "print(\"Tokens únicos:\", pos_limpio[\"palabra\"].nunique())\n",
    "\n",
    "display(documentos.head())\n"
   ]
