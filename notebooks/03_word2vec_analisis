    "\n",
    "# CELDA 7: SEIS ANALOGÍAS SEMÁNTICAS\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "# Cada analogía sigue la fórmula:\n",
    "# palabra1 - palabra2 + palabra3 = resultado esperado\n",
    "\n",
    "analogias = [\n",
    "    (\"actor\", \"hombre\", \"mujer\", \"actriz\"),\n",
    "    (\"director\", \"hombre\", \"mujer\", \"directora\"),\n",
    "    (\"rey\", \"hombre\", \"mujer\", \"reina\"),\n",
    "    (\"bueno\", \"malo\", \"triste\", \"alegre\"),\n",
    "    (\"terror\", \"miedo\", \"risa\", \"comedia\"),\n",
    "    (\"comedia\", \"risa\", \"miedo\", \"terror\")\n",
    "]\n",
    "\n",
    "resultados_analogias = []\n",
    "\n",
    "for nombre, modelo in [\n",
    "    (\"CBOW\", modelo_cbow),\n",
    "    (\"Skip-Gram\", modelo_skipgram)\n",
    "]:\n",
    "    for numero, (a, b, c, esperado) in enumerate(\n",
    "        analogias, start=1\n",
    "    ):\n",
    "\n",
    "        palabra_a = buscar_palabra(modelo, a)\n",
    "        palabra_b = buscar_palabra(modelo, b)\n",
    "        palabra_c = buscar_palabra(modelo, c)\n",
    "        palabra_esperada = buscar_palabra(modelo, esperado)\n",
    "\n",
    "        if None in [palabra_a, palabra_b, palabra_c]:\n",
    "            predicciones = []\n",
    "            estado = \"No evaluable: vocabulario insuficiente\"\n",
    "        else:\n",
    "            predicciones = modelo.wv.most_similar(\n",
    "                positive=[palabra_a, palabra_c],\n",
    "                negative=[palabra_b],\n",
    "                topn=5\n",
    "            )\n",
    "            estado = \"Evaluada\"\n",
    "\n",
    "        palabras_predichas = [\n",
    "            palabra for palabra, similitud in predicciones\n",
    "        ]\n",
    "\n",
    "        acierto = (\n",
    "            palabra_esperada is not None\n",
    "            and palabra_esperada in palabras_predichas\n",
    "        )\n",
    "\n",
    "        resultados_analogias.append({\n",
    "            \"modelo\": nombre,\n",
    "            \"analogia\": numero,\n",
    "            \"operacion\": f\"{a} - {b} + {c}\",\n",
    "            \"esperado\": esperado,\n",
    "            \"predicciones_top5\": \", \".join(\n",
    "                palabras_predichas\n",
    "            ),\n",
    "            \"acierto_top5\": acierto,\n",
    "            \"estado\": estado\n",
    "        })\n",
    "\n",
    "tabla_analogias = pd.DataFrame(resultados_analogias)\n",
    "\n",
    "print(\"RESULTADOS DE LAS SEIS ANALOGÍAS\")\n",
    "display(tabla_analogias)\n",
    "\n",
    "print(\"\\nRESUMEN POR MODELO\")\n",
