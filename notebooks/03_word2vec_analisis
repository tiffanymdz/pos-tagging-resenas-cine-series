    "\n",
    "# CELDA 9: SIMILITUD ENTRE CATEGORÍAS\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "# Verificar identificadores\n",
    "if \"id\" not in resenas.columns:\n",
    "    raise ValueError(\n",
    "        \"El archivo de reseñas no contiene la columna id.\"\n",
    "    )\n",
    "\n",
    "if resenas[\"id\"].duplicated().any():\n",
    "    raise ValueError(\n",
    "        \"Hay IDs duplicados en los metadatos.\"\n",
    "    )\n",
    "\n",
    "# Unir documentos con metadatos\n",
    "categorias = [\n",
    "    columna\n",
    "    for columna in [\"genero\", \"valoracion\", \"periodo\"]\n",
    "    if columna in resenas.columns\n",
    "]\n",
    "\n",
    "if not categorias:\n",
    "    raise ValueError(\n",
    "        \"No se encontraron las columnas de categorías.\"\n",
    "    )\n",
    "\n",
    "documentos_meta = documentos[[\"id\"]].merge(\n",
    "    resenas[[\"id\"] + categorias],\n",
    "    on=\"id\",\n",
    "    how=\"left\",\n",
    "    validate=\"one_to_one\"\n",
    ")\n",
    "\n",
    "assert len(documentos_meta) == len(X_cbow)\n",
    "assert len(documentos_meta) == len(X_skipgram)\n",
    "\n",
    "def calcular_similitud_categorias(\n",
    "    matriz, etiquetas\n",
    "):\n",
    "    etiquetas = etiquetas.fillna(\n",
    "        \"Sin dato\"\n",
    "    ).astype(str)\n",
    "\n",
    "    grupos = sorted(etiquetas.unique())\n",
    "\n",
    "    if len(grupos) < 2:\n",
    "        return None\n",
    "\n",
    "    # Centro global calculado con TODAS las reseñas\n",
    "    centro_global = matriz.mean(axis=0)\n",
    "\n",
    "    centroides = np.asarray([\n",
    "        matriz[\n",
    "            etiquetas.to_numpy() == grupo\n",
    "        ].mean(axis=0)\n",
    "        for grupo in grupos\n",
    "    ])\n",
    "\n",
    "    # Con dos categorías, evitar -1 artificial\n",
    "    if len(grupos) > 2:\n",
    "        vectores_comparacion = (\n",
    "            centroides - centro_global\n",
    "        )\n",
    "        metodo = \"Centrado global\"\n",
    "    else:\n",
    "        vectores_comparacion = centroides\n",
    "        metodo = \"Sin centrar (2 categorías)\"\n",
    "\n",
    "    similitudes = cosine_similarity(\n",
    "        vectores_comparacion\n",
    "    )\n",
    "\n",
    "    tabla = pd.DataFrame(\n",
    "        similitudes,\n",
    "        index=grupos,\n",
    "        columns=grupos\n",
    "    )\n",
    "\n",
    "    return tabla, metodo\n",
    "\n",
    "# Calcular y guardar comparaciones\n",
    "for categoria in categorias:\n",
    "\n",
    "    for nombre, matriz in [\n",
    "        (\"CBOW\", X_cbow),\n",
    "        (\"Skip-Gram\", X_skipgram)\n",
    "    ]:\n",
    "\n",
    "        resultado = calcular_similitud_categorias(\n",
    "            matriz,\n",
    "            documentos_meta[categoria]\n",
    "        )\n",
    "\n",
    "        if resultado is None:\n",
    "            print(\n",
    "                f\"{categoria} - {nombre}: \"\n",
    "                \"No hay suficientes categorías.\"\n",
    "            )\n",
    "            continue\n",
    "\n",
    "        tabla, metodo = resultado\n",
    "\n",
    "        print(\n",
    "            f\"\\nSIMILITUD: {categoria.upper()} - {nombre}\"\n",
    "        )\n",
    "        print(\"Método:\", metodo)\n",
    "\n",
    "        display(tabla.round(4))\n",
