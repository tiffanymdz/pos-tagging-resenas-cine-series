    "            SALIDA /\n",
    "            f\"similitud_{categoria}_{nombre.lower()}.csv\",\n",
    "            encoding=\"utf-8-sig\"\n",
    "        )\n",
    "\n",
    "print(\"\\nANÁLISIS DE SIMILITUD FINALIZADO\")\n"
