    "\n",
    "# CELDA 8: VECTORES WORD2VEC POR RESEÑA\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "def generar_vectores(modelo, documentos):\n",
    "    vectores = []\n",
    "    cantidad_tokens = []\n",
    "\n",
    "    for tokens in documentos[\"tokens\"]:\n",
    "        # Conservar únicamente palabras del vocabulario\n",
    "        palabras_validas = [\n",
    "            palabra for palabra in tokens\n",
    "            if palabra in modelo.wv\n",
    "        ]\n",
    "\n",
    "        cantidad_tokens.append(len(palabras_validas))\n",
    "\n",
    "        if palabras_validas:\n",
    "            # Promedio de los vectores de la reseña\n",
    "            vector = np.mean(\n",
    "                modelo.wv[palabras_validas],\n",
    "                axis=0\n",
    "            )\n",
    "        else:\n",
