    "# CELDA 10: VOCABULARIO EXCLUSIVO POR CATEGORÍA\n",
    "\n",
    "import pandas as pd\n",
    "from collections import Counter\n",
    "\n",
    "# Unir los tokens con los metadatos\n",
    "documentos_categorias = documentos[\n",
    "    [\"id\", \"tokens\"]\n",
    "].merge(\n",
    "    resenas[[\"id\"] + categorias],\n",
    "    on=\"id\",\n",
    "    how=\"left\",\n",
    "    validate=\"one_to_one\"\n",
    ")\n",
    "\n",
    "def vocabulario_exclusivo(df, columna):\n",
    "    etiquetas = df[columna].fillna(\"Sin dato\").astype(str)\n",
    "    grupos = sorted(etiquetas.unique())\n",
    "\n",
    "    vocabularios = {}\n",
    "    frecuencias = {}\n",
    "\n",
    "    for grupo in grupos:\n",
    "        tokens_grupo = [\n",
    "            palabra\n",
    "            for lista in df.loc[etiquetas == grupo, \"tokens\"]\n",
    "            for palabra in lista\n",
    "        ]\n",
    "\n",
    "        frecuencias[grupo] = Counter(tokens_grupo)\n",
    "        vocabularios[grupo] = set(tokens_grupo)\n",
    "\n",
    "    resultados = []\n",
    "\n",
    "    for grupo in grupos:\n",
    "        vocabulario_otros = set().union(\n",
    "            *[\n",
    "                vocabularios[otro]\n",
    "                for otro in grupos\n",
    "                if otro != grupo\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        exclusivos = (\n",
    "            vocabularios[grupo] - vocabulario_otros\n",
    "        )\n",
    "\n",
    "        mas_frecuentes = sorted(\n",
    "            exclusivos,\n",
    "            key=lambda palabra: (\n",
    "                -frecuencias[grupo][palabra],\n",
    "                palabra\n",
    "            )\n",
    "        )\n",
    "\n",
    "        resultados.append({\n",
    "            \"categoria\": grupo,\n",
    "            \"cantidad_exclusivas\": len(exclusivos),\n",
    "            \"top_20_exclusivas\": \", \".join(\n",
    "                mas_frecuentes[:20]\n",
    "            )\n",
    "        })\n",
    "\n",
    "    return pd.DataFrame(resultados)\n",
    "\n",
    "\n",
    "for categoria in categorias:\n",
    "    print(f\"\\nVOCABULARIO EXCLUSIVO: {categoria.upper()}\")\n",
    "\n",
    "    tabla = vocabulario_exclusivo(\n",
    "        documentos_categorias,\n",
    "        categoria\n",
    "    )\n",
    "\n",
    "    display(tabla)\n",
    "\n",
    "    tabla.to_csv(\n",
    "        SALIDA / f\"vocabulario_exclusivo_{categoria}.csv\",\n",
    "        index=False,\n",
    "        encoding=\"utf-8-sig\"\n",
    "    )\n",
    "\n",
    "print(\"\\nVOCABULARIO EXCLUSIVO FINALIZADO\")\n"
